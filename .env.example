# Local LiveKit development server.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-a-local-development-secret

# Moonshine streaming STT.
MOONSHINE_MODEL_DIR=models/moonshine
MOONSHINE_LANGUAGE=en
MOONSHINE_MODEL_ARCH=medium-streaming
MOONSHINE_UPDATE_INTERVAL=0.1

# Choose the fast CPU backend by default. Use kokoro-onnx for comparison.
VOICE_TTS_BACKEND=piper
PIPER_MODEL_PATH=models/piper/en_US-lessac-low.onnx
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W_SCALE=0.8

# Optional Kokoro ONNX comparison backend.
KOKORO_ONNX_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_ONNX_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_ONNX_VOICE=af_heart
KOKORO_ONNX_LANG=en-us
KOKORO_ONNX_SPEED=1.0
KOKORO_ONNX_SENTENCE_PAUSE=0.25
KOKORO_ONNX_CLAUSE_PAUSE=0.1

# Local llama.cpp OpenAI-compatible server.
LOCAL_LLM_API_KEY=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=qwen2.5-3b-instruct-q8_0.gguf
LOCAL_LLM_MAX_COMPLETION_TOKENS=96

# Voice pipeline latency and turn-taking.
VOICE_LLM_WARMUP=1
VOICE_LLM_WARMUP_TIMEOUT_S=3
VOICE_PREEMPTIVE_GENERATION=1
VOICE_PREEMPTIVE_TTS=0
VOICE_FIRST_CHUNK_MAX_CHARS=96
VOICE_FIRST_SENTENCE_MIN_CHARS=12
VOICE_FIRST_SENTENCE_MIN_WORDS=3
VOICE_ENDPOINTING_MIN_DELAY=0.25
VOICE_ENDPOINTING_MAX_DELAY=0.6
VOICE_HISTORY_MAX_ITEMS=8

# LiveKit worker resources.
VOICE_IDLE_PROCESSES=1
VOICE_JOB_MEMORY_WARN_MB=2500
VOICE_JOB_MEMORY_LIMIT_MB=0
VOICE_PROCESS_INIT_TIMEOUT=120
VOICE_AGENT_READY_TIMEOUT_S=45
VOICE_AGENT_READY_POLL_S=0.1

# RAG and PostgreSQL/pgvector.
RAG_ENABLED=1
DATABASE_URL=postgresql+psycopg://rag:rag_password@127.0.0.1:5433/rag
RAG_COLLECTION=voice_agent
RAG_MAX_DISTANCE=0.65
RAG_MAX_CONTEXT_CHARS=600
RAG_TOOL_MAX_CHARS=600
EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-xs
EMBEDDING_DEVICE=cpu
EMBEDDING_CPU_THREADS=2
EMBEDDING_QUERY_PROMPT=

# Logging and diagnostics.
VOICE_LOG_FILE=logfile.txt
VOICE_LOG_LEVEL=INFO
VOICE_LOG_MAX_BYTES=10485760
VOICE_LOG_BACKUP_COUNT=3
ORT_LOGGING_LEVEL=WARNING
